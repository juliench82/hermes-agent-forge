{
  "apiVersion": "hermes.platform/v1",
  "kind": "TenantSpec",
  "metadata": {"tenantId": "solo-founder", "displayName": "Solo Founder App Builder", "specVersion": "1.0.0", "status": "validated"},
  "business": {"objectives": ["Turn a product idea into a tested application through a coordinated specialist team."]},
  "security": {"baseline": "mandatory-baseline@1.0.0", "secretsProvider": "docker-secrets", "audit": {"enabled": true, "immutable": true, "retentionDays": 365}, "network": {"defaultDenyEgress": true}},
  "connectors": [{"id": "workspace", "primitive": "rest-api@1.0.0", "secretRefs": ["solo-founder/workspace/credentials"], "allowedOperations": ["filesystem.read", "filesystem.write", "git.diff", "git.read", "git.push", "github.write", "profile.delegate", "proposal.create", "security.scan", "task.create", "task.transition", "terminal.test"]}],
  "agents": [
    {"id": "orchestrator", "profile": "supervisor@1.0.0", "purpose": "Route and coordinate the solo-founder app-building workflow.", "isolation": {"dataNamespace": "solo-founder.orchestrator", "networkPolicy": "strict", "filesystem": "read_only"}, "connectors": [{"connectorId": "workspace", "scopes": ["filesystem.read", "task.create", "task.transition", "profile.delegate"]}], "delegates": {"allow": ["product-strategist", "architect", "builder", "quality-guardian", "self-improver"]}, "permissions": {"maxEffect": "write_limited"}},
    {"id": "product-strategist", "profile": "executor@1.0.0", "purpose": "Define user outcomes, scope, and testable acceptance criteria.", "isolation": {"dataNamespace": "solo-founder.product-strategist", "networkPolicy": "strict", "filesystem": "read_only"}, "connectors": [{"connectorId": "workspace", "scopes": ["filesystem.read"]}], "permissions": {"maxEffect": "read"}},
    {"id": "architect", "profile": "executor@1.0.0", "purpose": "Define constraints, interfaces, risks, and implementation plans.", "isolation": {"dataNamespace": "solo-founder.architect", "networkPolicy": "strict", "filesystem": "read_only"}, "connectors": [{"connectorId": "workspace", "scopes": ["filesystem.read", "git.read"]}], "permissions": {"maxEffect": "read"}},
    {"id": "builder", "profile": "executor@1.0.0", "purpose": "Implement approved changes and produce verification evidence.", "isolation": {"dataNamespace": "solo-founder.builder", "networkPolicy": "strict", "filesystem": "read_only"}, "connectors": [{"connectorId": "workspace", "scopes": ["filesystem.read", "filesystem.write", "terminal.test", "git.read", "git.push", "github.write"]}], "permissions": {"maxEffect": "irreversible", "confirmation": {"required": true}}},
    {"id": "quality-guardian", "profile": "executor@1.0.0", "purpose": "Independently verify scope, safety, tests, and acceptance criteria.", "isolation": {"dataNamespace": "solo-founder.quality-guardian", "networkPolicy": "strict", "filesystem": "read_only"}, "connectors": [{"connectorId": "workspace", "scopes": ["filesystem.read", "terminal.test", "security.scan", "git.diff"]}], "permissions": {"maxEffect": "read"}},
    {"id": "self-improver", "profile": "executor@1.0.0", "purpose": "Draft reviewed improvements from recurring failures and reusable knowledge.", "isolation": {"dataNamespace": "solo-founder.self-improver", "networkPolicy": "strict", "filesystem": "read_only"}, "connectors": [{"connectorId": "workspace", "scopes": ["filesystem.read", "proposal.create"]}], "permissions": {"maxEffect": "write_limited"}}
  ]
}
