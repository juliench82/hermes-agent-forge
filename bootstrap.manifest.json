{
  "schema_version": "bootstrap-manifest.v1",
  "repo_kind": "bootstrap",
  "default_team": {
    "name": "solo-founder",
    "profiles": [
      "orchestrator",
      "product-strategist",
      "architect",
      "builder",
      "quality-guardian"
    ],
    "optional_profiles": ["self-improver"]
  },
  "installer_entrypoint": "scripts/hermes_forge_install.py",
  "onboarding_manifest": "onboarding/onboarding.manifest.json",
  "config_onboarding_required": true,
  "state_directory": "~/.hermes-forge/",
  "description": "Bootstrap repository for hermes-agent-forge. Provisions a default solo-founder team with isolated Hermes profiles, adaptive config onboarding, and truthful state reporting."
}
