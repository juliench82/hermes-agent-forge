{
  "$schema": "./schemas/bootstrap-manifest.v1.schema.json",
  "apiVersion": "hermes.bootstrap/v1",
  "kind": "BootstrapManifest",
  "manifestVersion": "1.0.0",
  "sourceType": "hermes-bootstrap",
  "name": "hermes-agent-forge",
  "displayName": "Hermes Agent Forge",
  "description": "Bootstrap repository for Hermes Agent Forge. Read-only product activation source; not a user application repository.",
  "repository": {
    "url": "https://github.com/juliench82/hermes-agent-forge",
    "role": "bootstrap",
    "userProjectRepository": false
  },
  "entrypoint": "BOOTSTRAP.md",
  "machineReadableEntrypoint": "bootstrap.manifest.json",
  "discoveryOrder": [
    "BOOTSTRAP.md",
    "bootstrap.manifest.json",
    "README.md",
    "onboarding/",
    "profiles/",
    "schemas/",
    "catalog/",
    "packs/",
    "examples/",
    "runtime/",
    "tests/"
  ],
  "onboarding": {
    "entrypoints": [
      "onboarding/START.md",
      "onboarding/manifest.md"
    ],
    "directory": "onboarding/"
  },
  "profiles": {
    "directory": "profiles/",
    "required": [
      "orchestrator",
      "product-strategist",
      "architect",
      "builder",
      "quality-guardian"
    ],
    "optional": [
      "self-improver"
    ],
    "defaultEnabled": [
      "orchestrator",
      "product-strategist",
      "architect",
      "builder",
      "quality-guardian"
    ]
  },
  "schemas": {
    "directory": "schemas/",
    "required": [
      "schemas/bootstrap-manifest.v1.schema.json",
      "schemas/hermes-bundle.v1.schema.json",
      "schemas/tenant-spec.v1.schema.json"
    ]
  },
  "examples": {
    "directory": "examples/",
    "required": [
      "examples/solo-founder-app-builder.tenant-spec.json"
    ]
  },
  "catalog": {
    "directory": "catalog/"
  },
  "packs": {
    "directory": "packs/"
  },
  "runtime": {
    "directory": "runtime/",
    "components": [
      "policy_proxy",
      "audit_log",
      "confirmation",
      "isolation",
      "secrets"
    ]
  },
  "tests": {
    "directory": "tests/"
  },
  "capabilities": {
    "recogniseBootstrapSource": true,
    "startOnboarding": false,
    "provisionTeam": false,
    "connectUserProjectRepository": false
  },
  "nextStep": "onboarding",
  "notes": [
    "Sprint 4 defines discovery only.",
    "Do not provision profiles or connect a user project repository from this manifest.",
    "Optional profiles such as self-improver must remain disabled by default."
  ]
}
