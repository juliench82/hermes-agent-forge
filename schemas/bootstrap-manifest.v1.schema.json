{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-bootstrapper.dev/schemas/bootstrap-manifest.v1.schema.json",
  "title": "BootstrapManifest v1",
  "description": "Machine-readable contract that identifies a repository as a Hermes bootstrap source and declares the discovery order for onboarding, profiles, schemas, and examples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "manifestVersion",
    "sourceType",
    "name",
    "entrypoint",
    "discoveryOrder",
    "onboarding",
    "profiles",
    "schemas",
    "examples"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "apiVersion": {"const": "hermes.bootstrap/v1"},
    "kind": {"const": "BootstrapManifest"},
    "manifestVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sourceType": {"const": "hermes-bootstrap"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "userProjectRepository"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "role": {"const": "bootstrap"},
        "userProjectRepository": {"const": false}
      }
    },
    "entrypoint": {"const": "BOOTSTRAP.md"},
    "machineReadableEntrypoint": {"const": "bootstrap.manifest.json"},
    "discoveryOrder": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoints"],
      "properties": {
        "directory": {"type": "string"},
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "required", "defaultEnabled"],
      "properties": {
        "directory": {"type": "string"},
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "optional": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "defaultEnabled": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "required"],
      "properties": {
        "directory": {"type": "string"},
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "required"],
      "properties": {
        "directory": {"type": "string"},
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {"type": "string"}
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {"type": "string"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {"type": "string"},
        "components": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {"type": "string"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recogniseBootstrapSource": {"type": "boolean"},
        "startOnboarding": {"type": "boolean"},
        "provisionTeam": {"type": "boolean"},
        "connectUserProjectRepository": {"type": "boolean"}
      }
    },
    "nextStep": {
      "type": "string",
      "enum": ["onboarding", "team-proposal", "provisioning", "idle"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
