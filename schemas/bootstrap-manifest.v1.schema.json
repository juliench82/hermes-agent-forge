{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/juliench82/hermes-agents-forge/schemas/bootstrap-manifest.v1.schema.json",
  "title": "Bootstrap Manifest v1",
  "description": "Schema for bootstrap.manifest.json in Hermes Agents Forge repositories",
  "type": "object",
  "required": ["sourceType", "entrypoint", "machineReadableEntrypoint", "discoveryOrder"],
  "properties": {
    "sourceType": {
      "type": "string",
      "const": "hermes-bootstrap",
      "description": "Identifies this repository as a Hermes bootstrap source"
    },
    "entrypoint": {
      "type": "string",
      "const": "HERMES.md",
      "description": "Canonical human-readable activation entrypoint"
    },
    "machineReadableEntrypoint": {
      "type": "string",
      "const": "bootstrap.manifest.json",
      "description": "Machine-readable manifest file"
    },
    "discoveryOrder": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Ordered list of paths for bootstrap discovery"
    },
    "userProjectRepository": {
      "type": "boolean",
      "const": false,
      "description": "Must be false for bootstrap sources"
    },
    "profiles": {
      "type": "object",
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "defaultEnabled": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "recogniseBootstrapSource": {"type": "boolean"},
        "startOnboarding": {"type": "boolean"},
        "provisionTeam": {"type": "boolean"},
        "connectUserProjectRepository": {"type": "boolean"}
      }
    },
    "nextStep": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
